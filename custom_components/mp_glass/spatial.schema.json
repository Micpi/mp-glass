{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MP Spatial floor plan in metres",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "enabled", "floors"],
  "properties": {
    "version": {"const": 1},
    "enabled": {"type": "boolean"},
    "floors": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "elevation", "height", "rooms"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 80},
          "elevation": {"type": "number", "minimum": -20, "maximum": 100},
          "height": {"type": "number", "minimum": 1, "maximum": 8},
          "backdrop": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "width", "height", "scale", "origin"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
              "width": {"type": "integer", "minimum": 1, "maximum": 30000},
              "height": {"type": "integer", "minimum": 1, "maximum": 30000},
              "scale": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000}},
              "origin": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": -10000000, "maximum": 10000000}}
            }
          },
          "rooms": {
            "type": "array", "minItems": 1, "maxItems": 60,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "name", "polygon"],
              "properties": {
                "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"},
                "name": {"type": "string", "minLength": 1, "maxLength": 80},
                "areaId": {"type": "string", "minLength": 1, "maxLength": 255},
                "entityIds": {"type": "array", "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z_]+\\.[a-z0-9_]+$", "maxLength": 255}},
                "polygon": {
                  "type": "array", "minItems": 3, "maxItems": 40,
                  "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": -200, "maximum": 200}}
                },
                "arcs": {
                  "type": "array", "minItems": 3, "maxItems": 40,
                  "items": {"type": "number", "minimum": -1, "maximum": 1}
                },
                "openings": {
                  "type": "array", "maxItems": 24,
                  "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["id", "kind", "side", "at", "width"],
                    "properties": {
                      "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"},
                      "kind": {"enum": ["door", "window", "french_window"]},
                      "name": {"type": "string", "minLength": 1, "maxLength": 80},
                      "side": {"type": "integer", "minimum": 0, "maximum": 39},
                      "at": {"type": "number", "minimum": 0, "maximum": 1},
                      "width": {"type": "number", "minimum": 0.3, "maximum": 12},
                      "height": {"type": "number", "minimum": 0.3, "maximum": 8},
                      "sill": {"type": "number", "minimum": 0, "maximum": 6},
                      "entityIds": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "pattern": "^(cover|binary_sensor)\\.[a-z0-9_]+$", "maxLength": 255}}
                    }
                  }
                },
                "media": {
                  "type": "array", "maxItems": 12,
                  "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["id", "kind", "at"],
                    "properties": {
                      "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"},
                      "kind": {"enum": ["tv", "speaker"]},
                      "name": {"type": "string", "minLength": 1, "maxLength": 80},
                      "at": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": -200, "maximum": 200}},
                      "entityId": {"type": "string", "pattern": "^media_player\\.[a-z0-9_]+$", "maxLength": 255}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
